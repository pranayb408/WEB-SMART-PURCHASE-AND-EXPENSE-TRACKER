@model List<PersonalExpenseTracker.Models.Transaction>
@{
    ViewData["Title"] = "Purchases & Transactions";
    var allCategories = ViewBag.AllCategories as List<string> ?? PersonalExpenseTracker.Models.TransactionCategories.GetAll();
    var allPlatforms = ViewBag.AllPlatforms as List<string> ?? PersonalExpenseTracker.Models.PurchasePlatforms.GetAll();
    var months = System.Globalization.DateTimeFormatInfo.InvariantInfo.MonthNames.Take(12).Select((name, index) => new { Index = index + 1, Name = name }).ToList();
    decimal totalIncome = ViewBag.TotalIncome ?? 0m;
    decimal totalExpense = ViewBag.TotalExpense ?? 0m;
    decimal netBalance = totalIncome - totalExpense;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-receipt-cutoff text-primary me-2"></i>Purchases & Transactions
        </h2>
        <p class="text-muted mb-0">Record, search, and filter purchases from delivery apps, grocery services, and online platforms.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-success" asp-action="Create" asp-route-type="Income">
            <i class="bi bi-plus-circle me-1"></i> Add Income
        </a>
        <a class="btn btn-danger" asp-action="Create" asp-route-type="Expense">
            <i class="bi bi-dash-circle me-1"></i> Add Purchase
        </a>
    </div>
</div>

@if (ViewBag.DatabaseOffline == true)
{
    <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-4 me-3 text-warning"></i>
        <div>
            <strong>Database Offline Notice:</strong> MySQL server connection not established on localhost:3306.
            <div class="small text-muted mt-1">Please start MySQL in your XAMPP Control Panel or local service to query your records.</div>
        </div>
    </div>
}

<!-- Query String Filter Bar (Demonstrates Query Strings & Form Handling) -->
<div class="card card-custom bg-white mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <!-- Year Query Parameter -->
            <div class="col-md-2 col-6">
                <label class="form-label small fw-semibold">Year</label>
                <select name="year" class="form-select form-select-sm">
                    <option value="">All Years</option>
                    @for (int y = DateTime.Today.Year - 4; y <= DateTime.Today.Year + 5; y++)
                    {
                        <option value="@y" selected="@(ViewBag.SelectedYear != null && (int)ViewBag.SelectedYear == y)">@y</option>
                    }
                </select>
            </div>

            <!-- Month Query Parameter -->
            <div class="col-md-2 col-6">
                <label class="form-label small fw-semibold">Month</label>
                <select name="month" class="form-select form-select-sm">
                    <option value="">All Months</option>
                    @foreach (var m in months)
                    {
                        <option value="@m.Index" selected="@(ViewBag.SelectedMonth != null && (int)ViewBag.SelectedMonth == m.Index)">@m.Name</option>
                    }
                </select>
            </div>

            <!-- Type Query Parameter -->
            <div class="col-md-2 col-6">
                <label class="form-label small fw-semibold">Type</label>
                <select name="type" class="form-select form-select-sm">
                    <option value="">All Types</option>
                    <option value="Expense" selected="@(ViewBag.SelectedType == "Expense")">Purchases Only</option>
                    <option value="Income" selected="@(ViewBag.SelectedType == "Income")">Income Only</option>
                </select>
            </div>

            <!-- Category Filter -->
            <div class="col-md-2 col-6">
                <label class="form-label small fw-semibold">Category</label>
                <select name="category" class="form-select form-select-sm">
                    <option value="">All Categories</option>
                    @foreach (var cat in allCategories)
                    {
                        <option value="@cat" selected="@(ViewBag.SelectedCategory == cat)">@cat</option>
                    }
                </select>
            </div>

            <!-- Platform Filter -->
            <div class="col-md-2 col-6">
                <label class="form-label small fw-semibold">Platform</label>
                <select name="platform" class="form-select form-select-sm">
                    <option value="">All Platforms</option>
                    @foreach (var plat in allPlatforms)
                    {
                        <option value="@plat" selected="@(ViewBag.SelectedPlatform == plat)">@plat</option>
                    }
                </select>
            </div>

            <!-- Search Keyword -->
            <div class="col-md-2 col-6">
                <label class="form-label small fw-semibold">Search Title/Order #</label>
                <div class="input-group input-group-sm">
                    <input type="text" name="searchTerm" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search..." />
                    <button type="submit" class="btn btn-primary btn-sm" title="Apply Filters">
                        <i class="bi bi-funnel"></i>
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Reset Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Filter Summary Strip -->
<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="bg-success-subtle text-success p-2 px-3 rounded-3 d-flex justify-content-between align-items-center">
            <span class="small fw-semibold">Filtered Income:</span>
            <span class="fw-bold">+₹@totalIncome.ToString("N2")</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="bg-danger-subtle text-danger p-2 px-3 rounded-3 d-flex justify-content-between align-items-center">
            <span class="small fw-semibold">Filtered Purchases:</span>
            <span class="fw-bold">-₹@totalExpense.ToString("N2")</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="bg-primary-subtle text-primary p-2 px-3 rounded-3 d-flex justify-content-between align-items-center">
            <span class="small fw-semibold">Filtered Net:</span>
            <span class="fw-bold">₹@netBalance.ToString("N2")</span>
        </div>
    </div>
</div>

<!-- Responsive Transactions Table -->
<div class="card card-custom bg-white">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-custom">
                    <thead>
                        <tr>
                            <th class="ps-3">Date</th>
                            <th>Title & Order</th>
                            <th>Platform / App</th>
                            <th>Category</th>
                            <th>Type</th>
                            <th class="text-end">Amount</th>
                            <th>Payment & Notes</th>
                            <th class="text-center pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 text-nowrap fw-semibold">
                                    @item.Date.ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.Title</div>
                                    @if (!string.IsNullOrEmpty(item.OrderNumber))
                                    {
                                        <small class="text-muted font-monospace">
                                            <i class="bi bi-upc-scan me-1"></i>@item.OrderNumber
                                        </small>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Platform))
                                    {
                                        <span class="badge" style="@PersonalExpenseTracker.Models.PurchasePlatforms.GetBadgeStyle(item.Platform)">
                                            <i class="bi @PersonalExpenseTracker.Models.PurchasePlatforms.GetIcon(item.Platform) me-1"></i>
                                            @item.Platform
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">
                                        @item.Category
                                    </span>
                                </td>
                                <td>
                                    @if (item.Type == "Income")
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-arrow-down-left"></i> Income
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            <i class="bi bi-arrow-up-right"></i> Expense
                                        </span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <span class="fs-6 fw-bold @(item.Type == "Income" ? "text-success" : "text-danger")">
                                        @(item.Type == "Income" ? "+" : "-")₹@item.Amount.ToString("N2")
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.PaymentMethod))
                                    {
                                        <div class="small fw-semibold text-secondary">
                                            <i class="bi bi-credit-card me-1"></i>@item.PaymentMethod
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Notes))
                                    {
                                        <div class="small text-muted text-truncate" style="max-width: 180px;">
                                            @item.Notes
                                        </div>
                                    }
                                </td>
                                <td class="text-center pe-3 text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary py-0 px-2" title="Edit">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger py-0 px-2" title="Delete">
                                        <i class="bi bi-trash"></i> Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-receipt fs-1 text-secondary d-block mb-3"></i>
                <h5>No purchases found</h5>
                <p class="small text-secondary mb-3">No records match the selected filter criteria. Clear filters or record a new purchase.</p>
                <div class="d-flex justify-content-center gap-2">
                    <a asp-action="Create" asp-route-type="Expense" class="btn btn-sm btn-danger">
                        <i class="bi bi-plus-circle me-1"></i> Record Purchase
                    </a>
                    <a asp-action="Create" asp-route-type="Income" class="btn btn-sm btn-success">
                        <i class="bi bi-plus-circle me-1"></i> Add Income
                    </a>
                </div>
            </div>
        }
    </div>
</div>
