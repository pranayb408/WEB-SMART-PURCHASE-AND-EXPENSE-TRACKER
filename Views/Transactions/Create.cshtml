@model PersonalExpenseTracker.Models.Transaction
@{
    ViewData["Title"] = "Record Transaction";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-custom bg-white">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="fw-bold mb-0">Record Transaction</h3>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left"></i> Back to Transactions
                    </a>
                </div>
                <p class="text-muted small mt-1">Submit income or expense with category and details.</p>
            </div>
            <div class="card-body px-4 pb-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <partial name="_Form" model="Model" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check2-circle me-1"></i> Save Transaction
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

