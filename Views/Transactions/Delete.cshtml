@model PersonalExpenseTracker.Models.Transaction
@{
    ViewData["Title"] = "Delete Transaction";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-custom bg-white border-top border-4 border-danger">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                <div class="d-flex align-items-center gap-2 text-danger mb-2">
                    <i class="bi bi-exclamation-triangle-fill fs-3"></i>
                    <h3 class="fw-bold mb-0">Confirm Deletion</h3>
                </div>
                <p class="text-muted">Are you sure you want to delete this transaction record? This operation is permanent.</p>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="bg-light p-3 rounded-3 mb-4">
                    <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                        <span class="text-muted small">Title:</span>
                        <span class="fw-bold">@Model.Title</span>
                    </div>
                    <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                        <span class="text-muted small">Type:</span>
                        <span class="badge @(Model.Type == "Income" ? "bg-success" : "bg-danger")">@Model.Type</span>
                    </div>
                    <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                        <span class="text-muted small">Category:</span>
                        <span class="fw-semibold">@Model.Category</span>
                    </div>
                    <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                        <span class="text-muted small">Date:</span>
                        <span>@Model.Date.ToString("dd MMMM yyyy")</span>
                    </div>
                    <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                        <span class="text-muted small">Amount:</span>
                        <span class="fs-5 fw-bold @(Model.Type == "Income" ? "text-success" : "text-danger")">
                            @(Model.Type == "Income" ? "+" : "-")₹@Model.Amount.ToString("N2")
                        </span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="pt-1">
                            <span class="text-muted small d-block">Notes:</span>
                            <span class="small">@Model.Notes</span>
                        </div>
                    }
                </div>

                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash-fill me-1"></i> Delete Record
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

