@model PersonalExpenseTracker.Models.CategoryBudget
@{
    ViewData["Title"] = "Edit Category Budget";
    var months = System.Globalization.DateTimeFormatInfo.InvariantInfo.MonthNames.Take(12).Select((name, idx) => new { Index = idx + 1, Name = name }).ToList();
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card card-custom bg-white shadow-sm border p-4">
            <div class="d-flex align-items-center mb-3">
                <div class="icon-box bg-primary-subtle text-primary me-3">
                    <i class="bi bi-pencil-square fs-4"></i>
                </div>
                <div>
                    <h4 class="fw-bold mb-0">Edit Category Budget</h4>
                    <p class="text-muted small mb-0">Update spending limit for this category.</p>
                </div>
            </div>
            <hr class="text-muted my-3" />

            <form asp-action="EditCategoryBudget" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <!-- Category -->
                    <div class="col-12">
                        <label asp-for="CategoryId" class="form-label fw-semibold">Category <span class="text-danger">*</span></label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories"></select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>

                    <!-- Month -->
                    <div class="col-sm-6">
                        <label asp-for="Month" class="form-label fw-semibold">Month <span class="text-danger">*</span></label>
                        <select asp-for="Month" class="form-select">
                            @foreach (var m in months)
                            {
                                <option value="@m.Index" selected="@(m.Index == Model.Month)">@m.Name</option>
                            }
                        </select>
                        <span asp-validation-for="Month" class="text-danger small"></span>
                    </div>

                    <!-- Year -->
                    <div class="col-sm-6">
                        <label asp-for="Year" class="form-label fw-semibold">Year <span class="text-danger">*</span></label>
                        <select asp-for="Year" class="form-select">
                            @for (int y = DateTime.Today.Year - 4; y <= DateTime.Today.Year + 5; y++)
                            {
                                <option value="@y" selected="@(y == Model.Year)">@y</option>
                            }
                        </select>
                        <span asp-validation-for="Year" class="text-danger small"></span>
                    </div>

                    <!-- Budget Amount -->
                    <div class="col-12">
                        <label asp-for="Amount" class="form-label fw-semibold">Allocated Budget Limit (₹) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light fw-bold">₹</span>
                            <input asp-for="Amount" type="number" step="0.01" min="1" class="form-control form-control-lg" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-circle me-1"></i> Update Budget
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

