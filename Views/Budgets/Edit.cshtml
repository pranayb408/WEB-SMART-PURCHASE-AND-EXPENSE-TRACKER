@model PersonalExpenseTracker.Models.MonthlyBudget
@{
    ViewData["Title"] = "Edit Monthly Budget";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-custom bg-white">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="fw-bold mb-0">Edit Monthly Budget</h3>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-arrow-left"></i> Back to Budgets
                    </a>
                </div>
                <p class="text-muted small mt-1">Adjust the budget limit for record #@Model.Id.</p>
            </div>
            <div class="card-body px-4 pb-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <partial name="_Form" model="Model" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-save me-1"></i> Update Budget
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

