@model PersonalExpenseTracker.ViewModels.BudgetIndexViewModel
@{
    ViewData["Title"] = $"Budget Management — {Model.SelectedYear}";
    var months = System.Globalization.DateTimeFormatInfo.InvariantInfo.MonthNames.Take(12).Select((name, idx) => new { Index = idx + 1, Name = name }).ToList();
    var currentMonthName = months[Model.SelectedMonth - 1].Name;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-piggy-bank text-primary me-2"></i>Budget Management & Spending Limits
        </h2>
        <p class="text-muted mb-0">Define, monitor, and enforce monthly caps and category-wise spending targets.</p>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <!-- Year & Month Selector -->
        <form method="get" asp-action="Index" class="d-flex gap-1 align-items-center bg-white p-1 px-2 rounded-3 shadow-sm border">
            <label class="text-muted small fw-semibold me-1">Period:</label>
            <select name="month" class="form-select form-select-sm" onchange="this.form.submit()" aria-label="Select Month">
                @foreach (var m in months)
                {
                    <option value="@m.Index" selected="@(m.Index == Model.SelectedMonth)">@m.Name</option>
                }
            </select>
            <select name="year" class="form-select form-select-sm" onchange="this.form.submit()" aria-label="Select Year">
                @for (int y = DateTime.Today.Year - 4; y <= DateTime.Today.Year + 5; y++)
                {
                    <option value="@y" selected="@(y == Model.SelectedYear)">@y</option>
                }
            </select>
        </form>
        <a class="btn btn-outline-primary btn-sm" asp-action="Create">
            <i class="bi bi-calendar-plus me-1"></i> + Set Monthly Budget
        </a>
        <a class="btn btn-primary btn-sm shadow-sm" asp-action="CreateCategoryBudget" asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth">
            <i class="bi bi-tags-fill me-1"></i> + Set Category Budget
        </a>
    </div>
</div>

<!-- Section 9: Category Budgets for the Selected Month -->
<div class="card card-custom bg-white mb-4 shadow-sm border">
    <div class="card-header bg-transparent border-0 pt-3 pb-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h5 class="fw-bold mb-0">
                <i class="bi bi-tags text-primary me-2"></i>Category Budgets — <span class="text-primary">@currentMonthName @Model.SelectedYear</span>
            </h5>
            <small class="text-muted">Itemized category caps comparing allocated budget against realized purchase & standalone expenses</small>
        </div>
        <a asp-action="CreateCategoryBudget" asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth" class="btn btn-sm btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Add Category Target
        </a>
    </div>
    <div class="card-body p-0">
        @if (Model.CategoryBudgets.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-custom">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Category</th>
                            <th class="text-end">Budget Amount</th>
                            <th class="text-end">Actual Spending</th>
                            <th class="text-end">Remaining / Over</th>
                            <th style="width: 25%;">Consumption Progress</th>
                            <th class="text-center pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cb in Model.CategoryBudgets)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-dark">
                                    <i class="bi bi-tag-fill text-primary me-2"></i>@cb.CategoryName
                                </td>
                                <td class="text-end fw-semibold text-dark">
                                    ₹@cb.BudgetAmount.ToString("N2")
                                </td>
                                <td class="text-end fw-bold text-danger">
                                    ₹@cb.ActualSpending.ToString("N2")
                                </td>
                                <td class="text-end">
                                    @if (cb.IsOverBudget)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            Over by ₹@cb.OverBudgetAmount.ToString("N2")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            ₹@cb.RemainingBudget.ToString("N2") left
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 8px;">
                                            <div class="progress-bar @cb.ProgressBarClass" role="progressbar" 
                                                 style="width: @(Math.Min(100, cb.PercentageConsumed).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%;">
                                            </div>
                                        </div>
                                        <span class="small fw-semibold text-muted font-monospace" style="min-width: 45px;">
                                            @cb.PercentageConsumed.ToString("F1")%
                                        </span>
                                    </div>
                                </td>
                                <td class="text-center pe-3 text-nowrap">
                                    <a asp-action="EditCategoryBudget" asp-route-id="@cb.Id" class="btn btn-sm btn-outline-primary py-0 px-2" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="DeleteCategoryBudget" asp-route-id="@cb.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this category budget?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-tags fs-2 d-block mb-1 text-secondary"></i>
                <p class="mb-1">No category-wise budgets set for @currentMonthName @Model.SelectedYear.</p>
                <small class="text-muted d-block mb-3">Set individual targets for Food, Groceries, Shopping, Electronics, etc.</small>
                <a asp-action="CreateCategoryBudget" asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth" class="btn btn-sm btn-primary">
                    <i class="bi bi-plus-circle me-1"></i> Set First Category Budget
                </a>
            </div>
        }
    </div>
</div>

<!-- Section 9: Overall Monthly Budgets for the Year -->
<div class="card card-custom bg-white shadow-sm border">
    <div class="card-header bg-transparent border-0 pt-3 pb-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <h5 class="fw-bold mb-0">
                <i class="bi bi-calendar3 text-primary me-2"></i>Monthly Overall Budgets — @Model.SelectedYear
            </h5>
            <small class="text-muted">Total spending allowance across all categories for each month</small>
        </div>
        <a asp-action="Create" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-plus-circle me-1"></i> Set Monthly Limit
        </a>
    </div>
    <div class="card-body p-0">
        @if (Model.MonthlyBudgets.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-custom">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Month</th>
                            <th class="text-end">Monthly Limit</th>
                            <th class="text-end">Actual Spent</th>
                            <th class="text-end">Remaining / Over</th>
                            <th style="width: 25%;">Consumption Progress</th>
                            <th class="text-center pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.MonthlyBudgets)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-dark">
                                    <i class="bi bi-calendar-check text-primary me-2"></i>
                                    @months[b.Month - 1].Name @b.Year
                                </td>
                                <td class="text-end fw-semibold text-dark">
                                    ₹@b.BudgetAmount.ToString("N2")
                                </td>
                                <td class="text-end fw-bold text-danger">
                                    ₹@b.ActualSpending.ToString("N2")
                                </td>
                                <td class="text-end">
                                    @if (b.IsOverBudget)
                                    {
                                        <span class="badge bg-danger">
                                            Over by ₹@b.OverBudgetAmount.ToString("N2")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            ₹@b.RemainingBudget.ToString("N2") remaining
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="progress flex-grow-1" style="height: 8px;">
                                            <div class="progress-bar @b.ProgressBarClass" role="progressbar" 
                                                 style="width: @(Math.Min(100, b.PercentageConsumed).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%;">
                                            </div>
                                        </div>
                                        <span class="small fw-semibold text-muted font-monospace" style="min-width: 45px;">
                                            @b.PercentageConsumed.ToString("F1")%
                                        </span>
                                    </div>
                                </td>
                                <td class="text-center pe-3 text-nowrap">
                                    <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-outline-primary py-0 px-2" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@b.Id" class="btn btn-sm btn-outline-danger py-0 px-2" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-calendar-x fs-2 d-block mb-1 text-secondary"></i>
                <p class="mb-0">No monthly budgets configured for @Model.SelectedYear.</p>
                <a asp-action="Create" class="btn btn-sm btn-primary mt-2">
                    <i class="bi bi-plus-circle me-1"></i> Set a Monthly Budget
                </a>
            </div>
        }
    </div>
</div>
