@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center my-5">
    <div class="col-md-7 col-lg-6">
        <div class="card card-custom bg-white border-top border-4 border-danger text-center p-4">
            <div class="icon-box bg-danger-subtle text-danger mx-auto mb-3" style="width: 56px; height: 56px;">
                <i class="bi bi-exclamation-triangle-fill fs-3"></i>
            </div>
            <h3 class="fw-bold text-danger mb-2">Something Went Wrong</h3>
            <p class="text-muted mb-3">An unexpected error occurred while processing your request. Please try again or return to the dashboard.</p>
            @if (Model.ShowRequestId)
            {
                <div class="bg-light p-2 rounded mb-3 small text-muted">
                    <span>Tracking ID: <code>@Model.RequestId</code></span>
                </div>
            }
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-house-door me-1"></i> Return to Dashboard
                </a>
                <a href="javascript:history.back()" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Go Back
                </a>
            </div>
        </div>
    </div>
</div>
