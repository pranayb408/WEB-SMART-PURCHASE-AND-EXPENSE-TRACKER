@model List<PersonalExpenseTracker.Models.Platform>
@{
    ViewData["Title"] = "Platform Management";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-shop-window text-primary me-2"></i>Platform Management
        </h2>
        <p class="text-muted mb-0">Manage food delivery apps, quick commerce platforms, and shopping stores.</p>
    </div>
    <div>
        <button type="button" class="btn btn-primary rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#createPlatformModal">
            <i class="bi bi-plus-circle me-1"></i> Add Custom Platform
        </button>
    </div>
</div>

<div class="card card-custom bg-white shadow-sm overflow-hidden border">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Platform Name</th>
                    <th>Platform Type</th>
                    <th class="text-center">Active Status</th>
                    <th class="text-center">Historical Orders</th>
                    <th class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var platform in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-dark">
                                <i class="bi bi-shop me-2 text-primary"></i>@platform.Name
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @platform.PlatformType
                                </span>
                            </td>
                            <td class="text-center">
                                @if (platform.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border px-3 py-1">Inactive</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge bg-info-subtle text-info-emphasis rounded-pill px-2">
                                    @(platform.PurchaseOrders?.Count ?? 0) order(s)
                                </span>
                            </td>
                            <td class="text-end pe-3">
                                <div class="btn-group btn-group-sm">
                                    <form asp-action="ToggleActive" asp-route-id="@platform.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn @(platform.IsActive ? "btn-outline-warning" : "btn-outline-success")" title="@(platform.IsActive ? "Deactivate" : "Activate")">
                                            <i class="bi @(platform.IsActive ? "bi-slash-circle" : "bi-check-circle") me-1"></i>
                                            @(platform.IsActive ? "Deactivate" : "Activate")
                                        </button>
                                    </form>

                                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editModal-@platform.Id" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <form asp-action="Delete" asp-route-id="@platform.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete platform \'@platform.Name\'?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Delete" @(platform.PurchaseOrders != null && platform.PurchaseOrders.Any() ? "disabled" : "")>
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>

                                <!-- Edit Modal -->
                                <div class="modal fade text-start" id="editModal-@platform.Id" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form asp-action="Edit" asp-route-id="@platform.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-header">
                                                    <h5 class="modal-title fw-bold">Edit Platform: @platform.Name</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold">Platform Name</label>
                                                        <input type="text" name="name" value="@platform.Name" class="form-control" required />
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label fw-semibold">Platform Type</label>
                                                        <select name="platformType" class="form-select">
                                                            <option value="Food Delivery" selected="@(platform.PlatformType == "Food Delivery")">Food Delivery</option>
                                                            <option value="Groceries & Quick Commerce" selected="@(platform.PlatformType == "Groceries & Quick Commerce")">Groceries & Quick Commerce</option>
                                                            <option value="Shopping" selected="@(platform.PlatformType == "Shopping")">Shopping</option>
                                                            <option value="Direct / In-Store" selected="@(platform.PlatformType == "Direct / In-Store")">Direct / In-Store</option>
                                                            <option value="Other" selected="@(platform.PlatformType == "Other")">Other</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-primary">Save Changes</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-shop-window fs-2 text-secondary d-block mb-2"></i>
                            <h6 class="fw-bold mb-1">No platforms registered yet</h6>
                            <p class="small text-muted mb-3">Add platforms like Swiggy, Zomato, Blinkit, or Amazon to organize purchase orders.</p>
                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#createPlatformModal">
                                <i class="bi bi-plus-circle me-1"></i> Add Platform
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Platform Modal -->
<div class="modal fade" id="createPlatformModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-plus-circle text-primary me-2"></i>Add Platform
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Platform Name <span class="text-danger">*</span></label>
                        <input type="text" name="Name" class="form-control" placeholder="e.g. Uber Eats, DMart Ready, Tata Neu" required />
                        <small class="text-muted">Must be unique across platforms.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Platform Type</label>
                        <select name="PlatformType" class="form-select">
                            <option value="Food Delivery">Food Delivery</option>
                            <option value="Groceries & Quick Commerce">Groceries & Quick Commerce</option>
                            <option value="Shopping">Shopping</option>
                            <option value="Direct / In-Store">Direct / In-Store</option>
                            <option value="Other" selected>Other</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Add Platform</button>
                </div>
            </form>
        </div>
    </div>
</div>

