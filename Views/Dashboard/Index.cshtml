@model PersonalExpenseTracker.ViewModels.DashboardViewModel
@{
    var monthDate = new DateTime(Model.SelectedYear, Model.SelectedMonth, 1);
    var monthName = monthDate.ToString("MMMM yyyy");
    ViewData["Title"] = $"Dashboard - {monthName}";
    var months = System.Globalization.DateTimeFormatInfo.InvariantInfo.MonthNames.Take(12).Select((name, index) => new { Index = index + 1, Name = name }).ToList();
}

<!-- Top Dashboard Header with Title & Quick Action Buttons -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-speedometer2 text-primary me-2"></i>Smart Purchase & Expense Dashboard
        </h2>
        <p class="text-muted mb-0">Centralized purchases from food delivery, grocery platforms, and online shopping calculated for <span class="fw-semibold text-primary">@monthName</span>.</p>
    </div>

    <div class="d-flex flex-wrap gap-2 align-items-center">
        <a asp-controller="PurchaseOrders" asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="bi bi-cart-plus me-1"></i> + Record Purchase
        </a>
        <a asp-controller="Transactions" asp-action="Create" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-receipt me-1"></i> + Standalone Tx
        </a>
        <a asp-controller="Reports" asp-action="Index" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-graph-up-arrow me-1"></i> Reports &rarr;
        </a>
    </div>
</div>

<!-- Dynamic Multi-Criteria Filter Bar (Section 8: Filtering) -->
<div class="card card-custom bg-white p-3 mb-4 shadow-sm border">
    <form method="get" asp-controller="Dashboard" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-auto">
            <span class="small fw-bold text-muted text-uppercase"><i class="bi bi-funnel me-1"></i>Filter Period & Sources:</span>
        </div>
        <div class="col-sm-2 col-6">
            <select name="month" class="form-select form-select-sm" aria-label="Month">
                @foreach (var m in months)
                {
                    <option value="@m.Index" selected="@(m.Index == Model.SelectedMonth)">@m.Name</option>
                }
            </select>
        </div>
        <div class="col-sm-2 col-6">
            <select name="year" class="form-select form-select-sm" aria-label="Year">
                @for (int y = DateTime.Today.Year - 4; y <= DateTime.Today.Year + 5; y++)
                {
                    <option value="@y" selected="@(y == Model.SelectedYear)">@y</option>
                }
            </select>
        </div>
        <div class="col-sm-2 col-6">
            <select name="platformId" class="form-select form-select-sm" asp-items="Model.AvailablePlatforms" aria-label="Platform"></select>
        </div>
        <div class="col-sm-2 col-6">
            <select name="categoryId" class="form-select form-select-sm" asp-items="Model.AvailableCategories" aria-label="Category"></select>
        </div>
        <div class="col-sm-2 col-6">
            <select name="orderStatus" class="form-select form-select-sm" asp-items="Model.AvailableStatuses" aria-label="Status"></select>
        </div>
        <div class="col-auto d-flex gap-1">
            <button type="submit" class="btn btn-sm btn-primary" title="Apply Filters">
                <i class="bi bi-filter"></i> Apply
            </button>
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Reset Filters">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- Row 1: Core High-Level Financial Balances (Section 8) -->
<div class="row g-3 mb-3">
    <!-- 1. Net Balance -->
    <div class="col-lg-3 col-sm-6">
        <div class="card stat-card bg-white p-3 border-start border-4 @(Model.NetBalance >= 0 ? "border-primary" : "border-danger") h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Net Balance</span>
                    <h3 class="fw-bold @(Model.NetBalance >= 0 ? "text-primary" : "text-danger") mt-1 mb-0">
                        ₹@Model.NetBalance.ToString("N2")
                    </h3>
                </div>
                <div class="icon-box @(Model.NetBalance >= 0 ? "bg-primary-subtle text-primary" : "bg-danger-subtle text-danger")">
                    <i class="bi bi-wallet2 fs-4"></i>
                </div>
            </div>
            <small class="text-muted mt-2 d-block">Income − Overall Expenses</small>
        </div>
    </div>

    <!-- 2. Standalone Income -->
    <div class="col-lg-3 col-sm-6">
        <div class="card stat-card bg-white p-3 border-start border-4 border-success h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Standalone Income</span>
                    <h3 class="fw-bold text-success mt-1 mb-0">+₹@Model.StandaloneIncome.ToString("N2")</h3>
                </div>
                <div class="icon-box bg-success-subtle text-success">
                    <i class="bi bi-arrow-down-left-circle fs-4"></i>
                </div>
            </div>
            <small class="text-muted mt-2 d-block">Eligible Income transactions</small>
        </div>
    </div>

    <!-- 3. Overall Monthly Expenses -->
    <div class="col-lg-3 col-sm-6">
        <div class="card stat-card bg-white p-3 border-start border-4 border-danger h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Monthly Spending</span>
                    <h3 class="fw-bold text-danger mt-1 mb-0">₹@Model.TotalExpenses.ToString("N2")</h3>
                </div>
                <div class="icon-box bg-danger-subtle text-danger">
                    <i class="bi bi-cash-stack fs-4"></i>
                </div>
            </div>
            <small class="text-muted mt-2 d-block">Direct Expenses + Net Purchases</small>
        </div>
    </div>

    <!-- 4. Yearly Spending -->
    <div class="col-lg-3 col-sm-6">
        <div class="card stat-card bg-white p-3 border-start border-4 border-secondary h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Yearly Spending (@Model.SelectedYear)</span>
                    <h3 class="fw-bold text-dark mt-1 mb-0">₹@Model.YearlySpending.ToString("N2")</h3>
                </div>
                <div class="icon-box bg-light text-secondary">
                    <i class="bi bi-calendar3 fs-4"></i>
                </div>
            </div>
            <small class="text-muted mt-2 d-block">Annual cumulative spending</small>
        </div>
    </div>
</div>

<!-- Row 2: Purchases Breakdown & Refunds (Section 8) -->
<div class="row g-3 mb-4">
    <!-- Net Purchase Spending -->
    <div class="col-lg-3 col-sm-6">
        <div class="card stat-card bg-white p-3 border-start border-4 border-info h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Net Purchases</span>
                    <h4 class="fw-bold text-info-emphasis mt-1 mb-0">₹@Model.NetPurchaseSpending.ToString("N2")</h4>
                </div>
                <div class="icon-box bg-info-subtle text-info">
                    <i class="bi bi-cart-check fs-4"></i>
                </div>
            </div>
            <small class="text-muted mt-2 d-block">Completed bills minus refunds</small>
        </div>
    </div>

    <!-- Standalone Expenses -->
    <div class="col-lg-3 col-sm-6">
        <div class="card stat-card bg-white p-3 border-start border-4 border-warning h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Standalone Expenses</span>
                    <h4 class="fw-bold text-dark mt-1 mb-0">₹@Model.StandaloneExpenses.ToString("N2")</h4>
                </div>
                <div class="icon-box bg-warning-subtle text-warning">
                    <i class="bi bi-receipt fs-4"></i>
                </div>
            </div>
            <small class="text-muted mt-2 d-block">Direct non-order expenses</small>
        </div>
    </div>

    <!-- Recorded Refunds Total -->
    <div class="col-lg-3 col-sm-6">
        <div class="card stat-card bg-white p-3 border-start border-4 border-success h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Refunds Credited</span>
                    <h4 class="fw-bold text-success mt-1 mb-0">₹@Model.RefundTotals.ToString("N2")</h4>
                </div>
                <div class="icon-box bg-success-subtle text-success">
                    <i class="bi bi-arrow-counterclockwise fs-4"></i>
                </div>
            </div>
            <small class="text-muted mt-2 d-block">Excluded from net spending</small>
        </div>
    </div>

    <!-- Pending & Cancelled Orders -->
    <div class="col-lg-3 col-sm-6">
        <div class="card stat-card bg-white p-3 border-start border-4 border-secondary h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Pending Orders</span>
                    <h4 class="fw-bold text-secondary mt-1 mb-0">₹@Model.PendingPurchasesTotal.ToString("N2")</h4>
                </div>
                <div class="icon-box bg-light text-muted">
                    <i class="bi bi-hourglass-split fs-4"></i>
                </div>
            </div>
            <small class="text-muted mt-2 d-block">Cancelled: ₹@Model.CancelledPurchasesTotal.ToString("N2")</small>
        </div>
    </div>
</div>

<!-- 3. Monthly Budget Progress Section (Section 9) -->
<div class="card card-custom bg-white mb-4 p-3 border-start border-4 @(Model.IsOverBudget ? "border-danger" : (Model.HasBudget ? "border-primary" : "border-secondary"))">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-1 gap-2">
        <div>
            <span class="fw-bold text-dark fs-6">
                <i class="bi bi-piggy-bank text-primary me-2"></i>Monthly Budget Cap — @monthName
            </span>
            @if (Model.HasBudget)
            {
                <span class="badge @(Model.IsOverBudget ? "bg-danger" : "bg-primary") ms-2">
                    @Model.BudgetUsagePercentage% Consumed
                </span>
            }
        </div>
        <div class="text-end">
            @if (Model.HasBudget)
            {
                <span class="fw-bold @(Model.IsOverBudget ? "text-danger" : "text-dark")">
                    ₹@Model.TotalExpenses.ToString("N2") / ₹@Model.MonthlyBudgetAmount.ToString("N2")
                </span>
            }
            else
            {
                <a asp-controller="Budgets" asp-action="Create" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus-circle me-1"></i> Set Budget Limit
                </a>
            }
        </div>
    </div>

    @if (Model.HasBudget)
    {
        <div class="progress mb-2" style="height: 12px;">
            <div class="progress-bar @Model.ProgressBarClass progress-bar-striped progress-bar-animated" 
                 role="progressbar" 
                 style="width: @(Math.Min(100, Model.BudgetUsagePercentage).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%;" 
                 aria-valuenow="@Model.BudgetUsagePercentage" aria-valuemin="0" aria-valuemax="100">
            </div>
        </div>
        <div class="d-flex justify-content-between small text-muted">
            <span>Formula: Total Expenses / Monthly Budget × 100</span>
            <span>
                @if (Model.IsOverBudget)
                {
                    <strong class="text-danger"><i class="bi bi-exclamation-octagon-fill me-1"></i>Over budget by ₹@Model.OverBudgetAmount.ToString("N2")</strong>
                }
                else
                {
                    <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Remaining Budget: <strong>₹@Model.BudgetRemaining.ToString("N2")</strong></span>
                }
            </span>
        </div>
    }
</div>

<!-- 4. Visual Charts Row (Section 8: Proportional Category Breakdown & 6-Month Trend) -->
<div class="row g-4 mb-4">
    <div class="col-lg-5">
        <div class="card card-custom h-100 bg-white">
            <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Expenses by Category</h5>
                <small class="text-muted">Proportionally Allocated</small>
            </div>
            <div class="card-body d-flex flex-column justify-content-center align-items-center">
                @if (Model.CategoryExpenses.Any() && Model.CategoryExpenses.Values.Sum() > 0)
                {
                    <div style="position: relative; height: 260px; width: 100%;">
                        <canvas id="categoryChart"></canvas>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                        <p class="mb-0">No expense records found for @monthName.</p>
                        <small class="text-muted">Empty-state: database returned 0 matching records.</small>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card card-custom h-100 bg-white">
            <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">6-Month Trend Overview</h5>
                <small class="text-muted">Income vs. Realized Expenses</small>
            </div>
            <div class="card-body">
                <div style="position: relative; height: 260px; width: 100%;">
                    <canvas id="trendChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 5. Platform-Wise Spending Table & Top Platform Highlight (Section 8) -->
@if (Model.PlatformExpenses.Any())
{
    <div class="card card-custom bg-white mb-4 shadow-sm border">
        <div class="card-header bg-transparent border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Platform Spending Distribution</h5>
            <span class="badge bg-light text-dark border">
                Top Platform: <strong>@(Model.TopSpendingPlatform ?? "N/A")</strong> (₹@Model.TopPlatformAmount.ToString("N2"))
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-sm">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Platform</th>
                            <th class="text-end">Net Spending</th>
                            <th class="text-end pe-3">% of Purchases</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            decimal totalPlatformSpend = Model.PlatformExpenses.Values.Sum();
                        }
                        @foreach (var p in Model.PlatformExpenses)
                        {
                            decimal pct = totalPlatformSpend > 0 ? (p.Value / totalPlatformSpend) * 100 : 0m;
                            <tr>
                                <td class="ps-3 fw-medium">
                                    <i class="bi bi-shop text-primary me-2"></i>@p.Key
                                </td>
                                <td class="text-end fw-bold text-dark">
                                    ₹@p.Value.ToString("N2")
                                </td>
                                <td class="text-end pe-3">
                                    <span class="badge bg-secondary-subtle text-dark">@pct.ToString("F1")%</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- 6. Recent Smart Purchase Orders (Section 8) -->
<div class="card card-custom bg-white mb-4 shadow-sm border">
    <div class="card-header bg-transparent border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-0">Recent Purchase Orders for @monthName</h5>
            <small class="text-muted">Itemized orders with automatic platform charges & discounts</small>
        </div>
        <a asp-controller="PurchaseOrders" asp-action="Index" class="btn btn-sm btn-outline-primary">
            View All Purchases &rarr;
        </a>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentPurchaseOrders.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-custom">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Date</th>
                            <th>Platform</th>
                            <th>Order #</th>
                            <th>Items</th>
                            <th class="text-end">Final Bill</th>
                            <th class="text-end">Refund</th>
                            <th class="text-end">Net Spending</th>
                            <th class="text-center">Status</th>
                            <th class="text-end pe-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.RecentPurchaseOrders)
                        {
                            <tr>
                                <td class="ps-3 text-nowrap">@o.OrderDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-shop me-1 text-primary"></i>@o.PlatformName
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-dark border font-monospace">
                                        @(string.IsNullOrWhiteSpace(o.ExternalOrderNumber) ? $"ORD-{o.Id:D4}" : o.ExternalOrderNumber)
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info-emphasis rounded-pill px-2">
                                        @o.Items.Count item(s)
                                    </span>
                                </td>
                                <td class="text-end fw-semibold">₹@o.FinalBillAmount.ToString("N2")</td>
                                <td class="text-end text-success">
                                    @(o.RefundAmount > 0 ? $"-₹{o.RefundAmount:N2}" : "—")
                                </td>
                                <td class="text-end fw-bold text-danger">₹@o.NetPurchaseSpending.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge @(o.OrderStatus == OrderStatus.Completed ? "bg-success-subtle text-success border border-success-subtle" : (o.OrderStatus == OrderStatus.Pending ? "bg-warning-subtle text-warning border border-warning-subtle" : "bg-secondary-subtle text-secondary border border-secondary-subtle")) px-2 py-1">
                                        @o.OrderStatus
                                    </span>
                                </td>
                                <td class="text-end pe-3 text-nowrap">
                                    <a asp-controller="PurchaseOrders" asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-info py-0 px-2" title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-cart-x fs-2 d-block mb-1 text-secondary"></i>
                <p class="mb-0">No purchase orders recorded for @monthName.</p>
                <a asp-controller="PurchaseOrders" asp-action="Create" class="btn btn-sm btn-primary mt-2">
                    <i class="bi bi-cart-plus me-1"></i> Record First Purchase
                </a>
            </div>
        }
    </div>
</div>

<!-- 7. Recent Standalone Transactions for the Selected Month -->
<div class="card card-custom bg-white shadow-sm border">
    <div class="card-header bg-transparent border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-0">Recent Standalone Transactions for @monthName</h5>
            <small class="text-muted">Direct income & non-platform expenses</small>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Transactions" asp-action="Index" class="btn btn-sm btn-outline-primary">
                View All Tx &rarr;
            </a>
            <a asp-controller="Budgets" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                Budgets &rarr;
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentTransactions.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Date</th>
                            <th>Title & Order</th>
                            <th>Platform / Store</th>
                            <th>Category</th>
                            <th>Type</th>
                            <th class="text-end">Amount</th>
                            <th class="text-center pe-3">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.RecentTransactions)
                        {
                            <tr>
                                <td class="ps-3 text-nowrap">@t.Date.ToString("dd MMM yyyy")</td>
                                <td>
                                    <div class="fw-semibold">@t.Title</div>
                                    @if (!string.IsNullOrEmpty(t.OrderNumber))
                                    {
                                        <small class="text-muted font-monospace"><i class="bi bi-upc-scan me-1"></i>@t.OrderNumber</small>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(t.Platform))
                                    {
                                        <span class="badge" style="@PersonalExpenseTracker.Models.PurchasePlatforms.GetBadgeStyle(t.Platform)">
                                            <i class="bi @PersonalExpenseTracker.Models.PurchasePlatforms.GetIcon(t.Platform) me-1"></i>
                                            @t.Platform
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">
                                        @t.Category
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(t.Type == "Income" ? "bg-success" : "bg-danger")">
                                        @t.Type
                                    </span>
                                </td>
                                <td class="text-end text-nowrap">
                                    <span class="fw-bold @(t.Type == "Income" ? "text-success" : "text-danger")">
                                        @(t.Type == "Income" ? "+" : "-")₹@t.Amount.ToString("N2")
                                    </span>
                                </td>
                                <td class="text-center pe-3 text-nowrap">
                                    <a asp-controller="Transactions" asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary py-0 px-2" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4 text-muted">
                <i class="bi bi-receipt fs-2 d-block mb-1 text-secondary"></i>
                <p class="mb-0">No standalone transactions recorded for @monthName.</p>
                <a asp-controller="Transactions" asp-action="Create" class="btn btn-sm btn-primary mt-2">
                    <i class="bi bi-plus-circle me-1"></i> Record Standalone Tx
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        if (typeof Chart !== 'undefined') {
            // Category Doughnut Chart
            const catCanvas = document.getElementById('categoryChart');
            if (catCanvas) {
                const catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryExpenses.Keys));
                const catAmounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryExpenses.Values));

                if (catLabels.length > 0) {
                    new Chart(catCanvas, {
                        type: 'doughnut',
                        data: {
                            labels: catLabels,
                            datasets: [{
                                data: catAmounts,
                                backgroundColor: ['#4f46e5', '#06b6d4', '#10b981', '#f59e0b', '#ef4444', '#ec4899', '#8b5cf6', '#14b8a6', '#6366f1', '#84cc16', '#f97316', '#64748b'],
                                borderWidth: 2,
                                borderColor: '#ffffff'
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: { position: 'bottom', labels: { boxWidth: 12, padding: 10 } }
                            },
                            cutout: '65%'
                        }
                    });
                }
            }

            // 6-Month Trend Bar Chart
            const trendCanvas = document.getElementById('trendChart');
            if (trendCanvas) {
                const trendMonths = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendMonths));
                const trendIncomes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendIncomes));
                const trendExpenses = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendExpenses));

                new Chart(trendCanvas, {
                    type: 'bar',
                    data: {
                        labels: trendMonths,
                        datasets: [
                            {
                                label: 'Income',
                                data: trendIncomes,
                                backgroundColor: 'rgba(25, 135, 84, 0.7)',
                                borderColor: 'rgb(25, 135, 84)',
                                borderWidth: 1,
                                borderRadius: 4
                            },
                            {
                                label: 'Realized Expenses',
                                data: trendExpenses,
                                backgroundColor: 'rgba(220, 53, 69, 0.7)',
                                borderColor: 'rgb(220, 53, 69)',
                                borderWidth: 1,
                                borderRadius: 4
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: {
                                    callback: function(value) { return '₹' + value.toLocaleString(); }
                                }
                            }
                        },
                        plugins: {
                            legend: { position: 'top' }
                        }
                    }
                });
            }
        }
    </script>
}
