@model PersonalExpenseTracker.Models.PurchaseOrder
@{
    ViewData["Title"] = $"Purchase Order #{Model.Id} Details";
    var statusBadgeClass = Model.OrderStatus switch
    {
        "Completed" => "bg-success-subtle text-success border border-success-subtle",
        "Pending" => "bg-warning-subtle text-warning-emphasis border border-warning-subtle",
        "Cancelled" => "bg-danger-subtle text-danger border border-danger-subtle",
        _ => "bg-secondary-subtle text-secondary"
    };
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <!-- Header & Action Buttons -->
        <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
            <div>
                <h2 class="fw-bold mb-1">
                    <i class="bi bi-receipt-cutoff text-primary me-2"></i>Purchase Order #@Model.Id
                </h2>
                <p class="text-muted mb-0">
                    Recorded on @Model.OrderDate.ToString("dddd, dd MMMM yyyy") via <strong class="text-dark">@(Model.Platform?.Name ?? "Direct")</strong>
                </p>
            </div>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> Print / Export
                </button>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                    <i class="bi bi-pencil me-1"></i> Edit Order
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                    <i class="bi bi-trash me-1"></i> Delete
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
            </div>
        </div>

        <!-- 1. Order Info Card -->
        <div class="card card-custom bg-white p-4 mb-4 shadow-sm border">
            <div class="row g-3">
                <div class="col-md-3">
                    <span class="text-muted small text-uppercase fw-semibold d-block">Platform / Store</span>
                    <span class="badge bg-light text-dark border fs-6 mt-1">
                        <i class="bi bi-shop me-1 text-primary"></i>@(Model.Platform?.Name ?? "Direct Store")
                    </span>
                    <small class="text-muted d-block mt-1">Type: @(Model.Platform?.PlatformType ?? "Other")</small>
                </div>

                <div class="col-md-3">
                    <span class="text-muted small text-uppercase fw-semibold d-block">External Order #</span>
                    @if (!string.IsNullOrWhiteSpace(Model.ExternalOrderNumber))
                    {
                        <span class="badge bg-secondary-subtle text-dark border font-monospace fs-6 mt-1">
                            @Model.ExternalOrderNumber
                        </span>
                    }
                    else
                    {
                        <span class="text-muted fs-6 mt-1 d-block">Direct Manual Order</span>
                    }
                </div>

                <div class="col-md-3">
                    <span class="text-muted small text-uppercase fw-semibold d-block">Status</span>
                    <span class="badge @statusBadgeClass fs-6 px-3 py-1 mt-1">
                        @Model.OrderStatus
                    </span>
                </div>

                <div class="col-md-3">
                    <span class="text-muted small text-uppercase fw-semibold d-block">Payment Mode</span>
                    <span class="fs-6 mt-1 d-block fw-medium">
                        <i class="bi bi-credit-card me-1 text-secondary"></i>@Model.PaymentMethod
                    </span>
                    <small class="text-muted">Source: @Model.SourceType</small>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Notes))
                {
                    <div class="col-12 mt-3 pt-2 border-top">
                        <span class="text-muted small fw-semibold">Notes / Description:</span>
                        <p class="mb-0 text-dark small mt-1">@Model.Notes</p>
                    </div>
                }
            </div>
        </div>

        <!-- 2. Itemized Products Table -->
        <div class="card card-custom bg-white p-4 mb-4 shadow-sm border">
            <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">
                <i class="bi bi-basket2 text-primary me-2"></i>Itemized Products (@(Model.Items?.Count ?? 0))
            </h5>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 45%;">Item / Product Name</th>
                            <th style="width: 25%;">Category</th>
                            <th class="text-center" style="width: 10%;">Qty</th>
                            <th class="text-end" style="width: 10%;">Unit Price</th>
                            <th class="text-end pe-3" style="width: 10%;">Line Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3 fw-medium text-dark">
                                        @item.ItemName
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @(item.Category?.Name ?? "Groceries")
                                        </span>
                                    </td>
                                    <td class="text-center fw-semibold">
                                        @item.Quantity
                                    </td>
                                    <td class="text-end text-muted">
                                        ₹@item.UnitPrice.ToString("N2")
                                    </td>
                                    <td class="text-end pe-3 fw-bold text-dark">
                                        ₹@item.LineSubtotal.ToString("N2")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 3. Financial Bill Summary Card -->
        <div class="card card-custom bg-white p-4 mb-4 shadow-sm border">
            <h5 class="fw-bold mb-3 text-dark border-bottom pb-2">
                <i class="bi bi-receipt text-primary me-2"></i>Final Accounting Summary
            </h5>

            <div class="row">
                <div class="col-md-6 border-end">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between py-2 border-0">
                            <span class="text-muted">Items Subtotal:</span>
                            <span class="fw-semibold">₹@Model.ItemSubtotal.ToString("N2")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-2 border-0">
                            <span class="text-muted">Delivery Fee:</span>
                            <span>+₹@Model.DeliveryFee.ToString("N2")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-2 border-0">
                            <span class="text-muted">Packaging Fee:</span>
                            <span>+₹@Model.PackagingFee.ToString("N2")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-2 border-0">
                            <span class="text-muted">Platform Fee:</span>
                            <span>+₹@Model.PlatformFee.ToString("N2")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-2 border-0">
                            <span class="text-muted">Taxes & GST:</span>
                            <span>+₹@Model.Taxes.ToString("N2")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-2 border-0">
                            <span class="text-muted">Other Charges:</span>
                            <span>+₹@Model.OtherCharges.ToString("N2")</span>
                        </li>
                    </ul>
                </div>

                <div class="col-md-6">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between py-2 border-0 text-success">
                            <span>Discount / Coupons:</span>
                            <span class="fw-bold">-₹@Model.Discount.ToString("N2")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-3 border-top border-bottom border-2 bg-light rounded mt-2 px-3">
                            <span class="fw-bold fs-6">Final Bill Amount:</span>
                            <span class="fw-bold fs-5 text-primary">₹@Model.FinalBillAmount.ToString("N2")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-2 border-0 text-danger mt-2">
                            <span>Recorded Refund / Return:</span>
                            <span class="fw-bold">-₹@Model.RefundAmount.ToString("N2")</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between py-3 border-top border-2 border-danger-subtle bg-danger-subtle rounded mt-2 px-3">
                            <span class="fw-bold text-dark">Net Realized Spending:</span>
                            <span class="fw-bold fs-5 text-danger">₹@Model.NetPurchaseSpending.ToString("N2")</span>
                        </li>
                    </ul>

                    @if (Model.OrderStatus != "Completed")
                    {
                        <div class="alert alert-warning py-2 px-3 mt-3 mb-0 small">
                            <i class="bi bi-info-circle me-1"></i> Order status is <strong>@Model.OrderStatus</strong>. Net spending contributes ₹0.00 to expenses until marked Completed.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

