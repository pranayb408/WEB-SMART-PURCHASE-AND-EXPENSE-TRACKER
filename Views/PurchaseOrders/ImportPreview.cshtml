@model PersonalExpenseTracker.ViewModels.ImportPreviewViewModel
@{
    ViewData["Title"] = "CSV Import Preview & Validation";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-file-earmark-check text-success me-2"></i>CSV Import Preview
        </h2>
        <p class="text-muted mb-0">Review parsed purchase orders, verify multi-item groups, and confirm commit to database.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Import" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-arrow-repeat me-1"></i> Upload Another File
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="bi bi-x-circle me-1"></i> Cancel
        </a>
    </div>
</div>

<!-- Summary Metrics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card stat-card bg-white p-3 border-start border-4 border-info shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Rows Parsed</span>
                    <h4 class="fw-bold text-dark mt-1 mb-0">@Model.TotalRowsRead</h4>
                </div>
                <div class="icon-box bg-info-subtle text-info">
                    <i class="bi bi-list-ol fs-4"></i>
                </div>
            </div>
            <small class="text-muted mt-2 d-block">Grouped into @Model.TotalGroupsFound order(s)</small>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card stat-card bg-white p-3 border-start border-4 border-success shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Ready to Import</span>
                    <h4 class="fw-bold text-success mt-1 mb-0">@Model.ValidGroupsCount</h4>
                </div>
                <div class="icon-box bg-success-subtle text-success">
                    <i class="bi bi-check-circle fs-4"></i>
                </div>
            </div>
            <small class="text-muted mt-2 d-block">Valid non-duplicate orders</small>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card stat-card bg-white p-3 border-start border-4 border-warning shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Duplicates (Skipped)</span>
                    <h4 class="fw-bold text-warning mt-1 mb-0">@Model.DuplicateGroupsCount</h4>
                </div>
                <div class="icon-box bg-warning-subtle text-warning">
                    <i class="bi bi-copy fs-4"></i>
                </div>
            </div>
            <small class="text-muted mt-2 d-block">Already recorded in database</small>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card stat-card bg-white p-3 border-start border-4 border-danger shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span class="text-muted small text-uppercase fw-bold">Invalid Orders</span>
                    <h4 class="fw-bold text-danger mt-1 mb-0">@Model.InvalidGroupsCount</h4>
                </div>
                <div class="icon-box bg-danger-subtle text-danger">
                    <i class="bi bi-exclamation-triangle fs-4"></i>
                </div>
            </div>
            <small class="text-muted mt-2 d-block">Failed business validation</small>
        </div>
    </div>
</div>

<!-- Alert Banners -->
@if (Model.InvalidGroupsCount > 0)
{
    <div class="alert alert-danger shadow-sm mb-4">
        <i class="bi bi-exclamation-octagon-fill me-2"></i>
        <strong>@Model.InvalidGroupsCount order(s) have validation errors.</strong> They will be omitted during import. Inspect details below.
    </div>
}
@if (Model.DuplicateGroupsCount > 0)
{
    <div class="alert alert-warning shadow-sm mb-4">
        <i class="bi bi-shield-exclamation me-2"></i>
        <strong>@Model.DuplicateGroupsCount duplicate order(s) detected.</strong> Orders with identical Platform and Order Number already exist in the database and will be safely skipped.
    </div>
}

<!-- Order Groups Accordion -->
<div class="card border-0 shadow-sm rounded-3 bg-white mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h5 class="fw-bold mb-0 text-dark">
            <i class="bi bi-boxes text-primary me-2"></i>Grouped Orders Breakdown (@Model.TotalGroupsFound)
        </h5>
        @if (Model.ValidGroupsCount > 0)
        {
            <form asp-action="CommitImport" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success px-4 fw-semibold shadow-sm">
                    <i class="bi bi-check2-circle me-1"></i> Commit &amp; Import @Model.ValidGroupsCount Valid Order(s)
                </button>
            </form>
        }
    </div>
    <div class="card-body p-3">
        <div class="accordion" id="ordersAccordion">
            @for (int i = 0; i < Model.Groups.Count; i++)
            {
                var group = Model.Groups[i];
                string collapseId = $"collapseGroup{i}";
                string headerId = $"headingGroup{i}";
                string badgeClass = group.IsDuplicate ? "bg-warning text-dark" : (!group.IsValid ? "bg-danger" : "bg-success");
                string badgeText = group.IsDuplicate ? "Duplicate (Skip)" : (!group.IsValid ? "Invalid" : "Valid");

                <div class="accordion-item mb-2 border rounded-3 overflow-hidden">
                    <h2 class="accordion-header" id="@headerId">
                        <button class="accordion-button collapsed py-2 px-3 bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                            <div class="d-flex flex-wrap align-items-center justify-content-between w-100 me-3 gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @badgeClass me-1">@badgeText</span>
                                    <span class="fw-bold text-dark">@group.PlatformName</span>
                                    <span class="badge bg-secondary-subtle text-secondary font-monospace">
                                        @(string.IsNullOrWhiteSpace(group.ExternalOrderNumber) ? "No Order #" : group.ExternalOrderNumber)
                                    </span>
                                </div>
                                <div class="d-flex align-items-center gap-3 small">
                                    <span class="text-muted"><i class="bi bi-calendar3 me-1"></i>@group.OrderDate.ToString("yyyy-MM-dd")</span>
                                    <span class="text-muted"><i class="bi bi-basket me-1"></i>@group.Items.Count items</span>
                                    <span class="fw-bold text-dark">Bill: ₹@group.FinalBillAmount.ToString("N2")</span>
                                    @if (group.RefundAmount > 0)
                                    {
                                        <span class="text-danger small">(-₹@group.RefundAmount.ToString("N2"))</span>
                                    }
                                </div>
                            </div>
                        </button>
                    </h2>
                    <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@headerId" data-bs-parent="#ordersAccordion">
                        <div class="accordion-body p-3">
                            <!-- Group validation errors if any -->
                            @if (group.ValidationErrors.Any())
                            {
                                <div class="alert alert-danger py-2 px-3 small mb-3">
                                    <ul class="mb-0 ps-3">
                                        @foreach (var err in group.ValidationErrors)
                                        {
                                            <li>@err</li>
                                        }
                                    </ul>
                                </div>
                            }

                            <!-- Financial Breakdown -->
                            <div class="row g-2 mb-3 bg-light p-2 rounded-2 small text-muted">
                                <div class="col-sm-2"><strong>Items Subtotal:</strong> ₹@group.ItemsSubtotal.ToString("N2")</div>
                                <div class="col-sm-2"><strong>Fees &amp; Taxes:</strong> ₹@((group.DeliveryFee + group.PackagingFee + group.PlatformFee + group.Taxes + group.OtherCharges).ToString("N2"))</div>
                                <div class="col-sm-2"><strong>Discount:</strong> ₹@group.Discount.ToString("N2")</div>
                                <div class="col-sm-2"><strong>Final Bill:</strong> <span class="fw-bold text-dark">₹@group.FinalBillAmount.ToString("N2")</span></div>
                                <div class="col-sm-2"><strong>Refund:</strong> ₹@group.RefundAmount.ToString("N2")</div>
                                <div class="col-sm-2"><strong>Net Spending:</strong> <span class="fw-bold text-primary">₹@group.NetSpending.ToString("N2")</span></div>
                            </div>

                            <!-- Items Table -->
                            <h6 class="fw-bold small text-uppercase text-muted mb-2">Order Items</h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-hover align-middle mb-0">
                                    <thead class="table-light small">
                                        <tr>
                                            <th>Row #</th>
                                            <th>Item Name</th>
                                            <th>Category</th>
                                            <th class="text-center">Qty</th>
                                            <th class="text-end">Unit Price</th>
                                            <th class="text-end">Line Total</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody class="small">
                                        @foreach (var item in group.Items)
                                        {
                                            <tr>
                                                <td><span class="badge bg-light text-dark border">Row @item.RowNumber</span></td>
                                                <td class="fw-semibold">@item.ItemName</td>
                                                <td><span class="badge bg-info-subtle text-info">@item.CategoryName</span></td>
                                                <td class="text-center">@item.Quantity</td>
                                                <td class="text-end">₹@item.UnitPrice.ToString("N2")</td>
                                                <td class="text-end fw-bold">₹@item.LineSubtotal.ToString("N2")</td>
                                                <td>
                                                    @if (item.IsValid)
                                                    {
                                                        <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>OK</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-danger" title="@string.Join("; ", item.Errors)"><i class="bi bi-exclamation-circle-fill me-1"></i>Error</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center">
        <a asp-action="Import" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back to Upload
        </a>
        @if (Model.ValidGroupsCount > 0)
        {
            <form asp-action="CommitImport" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success px-4 fw-semibold shadow-sm">
                    <i class="bi bi-check2-circle me-1"></i> Commit &amp; Import @Model.ValidGroupsCount Valid Order(s)
                </button>
            </form>
        }
        else
        {
            <button class="btn btn-secondary px-4" disabled>No Valid Orders to Import</button>
        }
    </div>
</div>

